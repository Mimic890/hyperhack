    {
      "type": "piechart",
      "id": 17,
      "title": "Theme",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 18,
        "y": 32,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
