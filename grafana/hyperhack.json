    {
      "type": "table",
      "id": 18,
      "title": "Outbound clicks",
      "description": "Top 20 external hosts readers clicked, in the selected range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
