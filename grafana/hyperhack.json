    {
      "type": "piechart",
      "id": 16,
      "title": "UI language",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (lang) (increase(hyperhack_post_ui_lang_total{slug=~\"$slug\"}[$__range]))",
