# Copy to .env and set real values. Keep .env at mode 0600: chmod 600 .env
# Generate secrets with: openssl rand -base64 48

# Site
SITE_NAME=Example Blog
SITE_URL=https://example.com
DEFAULT_LANG=en
GITHUB_URL=https://github.com/example

# S3 (Garage). Read-only key. HTTPS only.
S3_ENDPOINT=https://s3.example.com
S3_REGION=garage
S3_BUCKET=example-blog
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
POLL_INTERVAL=60s

# Secrets, at least 32 bytes each
REINDEX_TOKEN=change-me-to-at-least-32-random-bytes
ALTCHA_HMAC_KEY=change-me-to-at-least-32-random-bytes
VISITOR_SECRET=change-me-to-at-least-32-random-bytes

# ALTCHA
ALTCHA_EXPIRES=5m
ALTCHA_MAX_NUMBER=100000

# Content
READING_WPM=200
POPULAR_DAYS=30
POPULAR_LIMIT=5
PAGE_SIZE=10
RSS_LIMIT=20
DEFAULT_OG_IMAGE=
INDEXNOW_KEY=

# Logs: debug | info | warn | error; json | text
LOG_LEVEL=info
LOG_FORMAT=json

# Paths inside the container
DATA_DIR=/data
VAULT_DIR=/vault

# Rate limits per client: count/period
RATE_LIMIT_VOTE=10/1m
RATE_LIMIT_BEACON=30/1m
RATE_LIMIT_SEARCH=30/1m
RATE_LIMIT_REINDEX=5/1m

# Comma-separated CIDRs. Empty = loopback and private ranges.
METRICS_ALLOW=
REINDEX_ALLOW=
# Proxy IPs/CIDRs allowed to set X-Forwarded-For. Empty = trust no proxy.
TRUSTED_PROXIES=

# Bucket limits
MAX_POST_BYTES=1048576
MAX_ASSET_BYTES=52428800
MAX_OBJECTS=10000
